<%- include('partials/header') %>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-lg">
                <div class="card-body p-5">
                    <h3 class="text-center text-pink fw-bold mb-4">
                        <i class="bi bi-pencil-square"></i> Edit Profile
                    </h3>

                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <%= error %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    <% } %>

                    <form action="/profile/edit" method="POST" enctype="multipart/form-data">
                        <!-- Current Profile Picture -->
                        <div class="text-center mb-4">
                            <img src="<%= user.profilePic %>" id="previewImage" 
                                 class="rounded-circle" width="120" height="120" 
                                 style="object-fit: cover; border: 3px solid #FFE4E1;">
                        </div>

                        <!-- Profile Picture Upload -->
                        <div class="mb-4">
                            <label for="profilePic" class="form-label text-secondary fw-500">Profile Picture</label>
                            <input type="file" name="profilePic" id="profilePic" 
                                   class="form-control form-control-lg border-light-pink" 
                                   accept="image/jpeg,image/png,image/gif,image/webp"
                                   onchange="previewProfilePic(event)">
                            <small class="text-muted">Supported: JPG, PNG, GIF, WebP (Max 5MB)</small>
                        </div>

                        <!-- Username -->
                        <div class="mb-4">
                            <label for="username" class="form-label text-secondary fw-500">Username *</label>
                            <input type="text" name="username" id="username" 
                                   value="<%= user.username %>" 
                                   class="form-control form-control-lg border-light-pink" 
                                   required placeholder="Choose a unique username">
                        </div>

                        <!-- Full Name -->
                        <div class="mb-4">
                            <label for="fullName" class="form-label text-secondary fw-500">Full Name *</label>
                            <input type="text" name="fullName" id="fullName" 
                                   value="<%= user.fullName %>" 
                                   class="form-control form-control-lg border-light-pink" 
                                   required placeholder="Enter your full name">
                        </div>

                        <!-- Bio -->
                        <div class="mb-4">
                            <label for="bio" class="form-label text-secondary fw-500">Bio</label>
                            <textarea name="bio" id="bio" 
                                      class="form-control form-control-lg border-light-pink" 
                                      rows="3" placeholder="Tell people about yourself..."
                                      maxlength="500"><%= user.bio %></textarea>
                            <small class="text-muted">Max 500 characters</small>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-pink btn-lg flex-grow-1 fw-semibold">
                                <i class="bi bi-check-circle"></i> Save Changes
                            </button>
                            <a href="/profile" class="btn btn-outline-secondary btn-lg">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function previewProfilePic(event) {
        const file = event.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('previewImage').src = e.target.result;
            };
            reader.readAsDataURL(file);
        }
    }
</script>

<%- include('partials/footer') %>