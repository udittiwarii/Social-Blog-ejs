<%- include('partials/header') %>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card border-0 shadow-sm rounded-lg p-5">
                <i class="bi bi-exclamation-circle text-danger" style="font-size: 3rem;"></i>
                <h2 class="text-dark mt-4 fw-bold">Oops! Something went wrong</h2>
                <p class="text-muted fs-5 my-3"><%= typeof message !== 'undefined' ? message : 'An error occurred' %></p>
                <a href="/" class="btn btn-pink btn-lg mt-3">
                    <i class="bi bi-house"></i> Back to Home
                </a>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
