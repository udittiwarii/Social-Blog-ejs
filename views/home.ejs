<%- include('partials/header') %>

<div class="container mt-5">
    <div class="row">
        <% if (posts && posts.length > 0) { %>
            <% posts.forEach(post => { %>
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card border-0 shadow-sm rounded-lg h-100 overflow-hidden hover-card">
                        <!-- Post Image -->
                        <% if (post.imageUrl) { %>
                            <div class="post-image-wrapper" style="height: 250px; overflow: hidden;">
                                <img src="<%= post.imageUrl %>" alt="<%= post.title %>" 
                                     class="card-img-top" style="height: 100%; object-fit: cover;">
                            </div>
                        <% } %>

                        <div class="card-body">
                            <!-- Author Info -->
                            <div class="d-flex align-items-center mb-3">
                                <img src="<%= post.author.profilePic %>" alt="<%= post.author.username %>" 
                                     class="rounded-circle me-2" width="36" height="36">
                                <div class="flex-grow-1">
                                    <a href="/profile/<%= post.author.username %>" 
                                       class="text-decoration-none fw-semibold text-dark">
                                        <%= post.author.username %>
                                    </a>
                                    <br>
                                    <small class="text-muted">
                                        <%= new Date(post.createdAt).toLocaleDateString('en-US', { 
                                            month: 'short', 
                                            day: 'numeric',
                                            year: 'numeric'
                                        }) %>
                                    </small>
                                </div>
                            </div>

                            <!-- Post Title -->
                            <h5 class="card-title text-dark fw-bold mb-2">
                                <%= post.title.length > 50 ? post.title.substring(0, 50) + '...' : post.title %>
                            </h5>

                            <!-- Post Content -->
                            <p class="card-text text-muted small mb-3">
                                <%= post.content.length > 100 ? post.content.substring(0, 100) + '...' : post.content %>
                            </p>

                            <!-- View Profile Button -->
                            <a href="/profile/<%= post.author.username %>" class="btn btn-sm btn-outline-pink w-100">
                                View Profile
                            </a>
                        </div>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div class="col-12">
                <div class="text-center py-5">
                    <h4 class="text-muted">No posts yet</h4>
                    <p class="text-muted">Be the first to share your thoughts!</p>
                    <% if (typeof user !== 'undefined' && user) { %>
                        <a href="/posts/compose" class="btn btn-pink">Create Your First Post</a>
                    <% } else { %>
                        <a href="/login" class="btn btn-pink">Login to Post</a>
                    <% } %>
                </div>
            </div>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>
