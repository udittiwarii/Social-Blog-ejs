<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Social Blog' %></title>
    
    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Google Fonts - Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Custom CSS -->
    <link href="/css/style.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom border-light-pink sticky-top">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold fs-5 text-pink" href="/">
                <i class="bi bi-pencil-square"></i> BlogHub
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <div class="ms-auto d-flex gap-3 align-items-center">
                    <% if (typeof user !== 'undefined' && user) { %>
                        <a href="/posts/compose" class="btn btn-sm btn-pink">
                            <i class="bi bi-plus-circle"></i> New Post
                        </a>
                        <div class="dropdown">
                            <img src="<%= user.profilePic %>" alt="profile " 
                                 class="rounded-circle cursor-pointer" width="40" height="40" 
                                 role="button" data-bs-toggle="dropdown">
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/profile"><i class="bi bi-person"></i> My Profile</a></li>
                                <li><a class="dropdown-item" href="/profile/edit"><i class="bi bi-pencil"></i> Edit Profile</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="/auth/logout"><i class="bi bi-box-arrow-right"></i> Logout</a></li>
                            </ul>
                        </div>
                    <% } else { %>
                        <a href="/auth/login" class="btn btn-sm btn-outline-pink">Login</a>
                        <a href="/auth/register" class="btn btn-sm btn-pink">Sign Up</a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>
