<%- include('partials/header') %>

<div class="container mt-5 mb-5">
    <div class="row">
        <!-- Profile Info Section -->
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm rounded-lg sticky-md-top">
                <div class="card-body text-center">
                    <!-- Profile Picture -->
                    <img src="<%= user.profilePic %>" alt="<%= user.username %>" 
                         class="rounded-circle mb-3" width="120" height="120" 
                         style="object-fit: cover; border: 3px solid #FFE4E1;">

                    <!-- Username -->
                    <h4 class="text-dark fw-bold mb-1">@<%= user.username %></h4>

                    <!-- Full Name -->
                    <p class="text-muted fw-500 mb-3"><%= user.fullName %></p>

                    <!-- Bio -->
                    <p class="text-muted mb-4"><%= user.bio || 'No bio yet' %></p>

                    <!-- Stats -->
                    <div class="row text-center mb-4">
                        <div class="col-6">
                            <div class="p-3 bg-light-pink rounded">
                                <h5 class="text-pink fw-bold mb-0"><%= typeof posts !== 'undefined' ? posts.length : 0 %></h5>
                                <small class="text-muted">Posts</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 bg-light-pink rounded">
                                <h5 class="text-pink fw-bold mb-0">
                                    <%= new Date(user.createdAt).getFullYear() %>
                                </h5>
                                <small class="text-muted">Member</small>
                            </div>
                        </div>
                    </div>

                    <!-- Edit Profile Button (if own profile) -->
                    <% if (typeof isOwnProfile !== 'undefined' && isOwnProfile) { %>
                        <a href="/profile/edit" class="btn btn-pink w-100 fw-semibold">
                            <i class="bi bi-pencil"></i> Edit Profile
                        </a>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Posts Section -->
        <div class="col-md-8">
            <h5 class="text-dark fw-bold mb-4">
                <i class="bi bi-file-earmark-text text-pink"></i> 
                <%= typeof isOwnProfile !== 'undefined' && isOwnProfile ? 'My Posts' : 'Posts' %>
            </h5>

            <% if (typeof posts !== 'undefined' && posts.length > 0) { %>
                <div class="row g-3">
                    <% posts.forEach(post => { %>
                        <div class="col-md-6 col-lg-4">
                            <div class="card border-0 shadow-sm rounded-lg overflow-hidden hover-card h-100">
                                <!-- Post Image -->
                                <% if (post.imageUrl) { %>
                                    <div style="height: 200px; overflow: hidden;">
                                        <img src="<%= post.imageUrl %>" alt="<%= post.title %>" 
                                             style="width: 100%; height: 100%; object-fit: cover;">
                                    </div>
                                <% } else { %>
                                    <div style="height: 200px; background: linear-gradient(135deg, #FFE4E1 0%, #FFC0CB 100%); display: flex; align-items: center; justify-content: center;">
                                        <i class="bi bi-image text-white" style="font-size: 3rem;"></i>
                                    </div>
                                <% } %>

                                <div class="card-body d-flex flex-column">
                                    <h6 class="card-title text-dark fw-bold mb-2">
                                        <%= post.title.length > 40 ? post.title.substring(0, 40) + '...' : post.title %>
                                    </h6>
                                    <p class="card-text text-muted small flex-grow-1 mb-2">
                                        <%= post.content.length > 60 ? post.content.substring(0, 60) + '...' : post.content %>
                                    </p>
                                    <small class="text-muted">
                                        <%= new Date(post.createdAt).toLocaleDateString('en-US', { 
                                            month: 'short', 
                                            day: 'numeric'
                                        }) %>
                                    </small>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                    <h5 class="text-muted mt-3">
                        <%= typeof isOwnProfile !== 'undefined' && isOwnProfile ? 'No posts yet' : 'No posts from this user' %>
                    </h5>
                    <% if (typeof isOwnProfile !== 'undefined' && isOwnProfile) { %>
                        <p class="text-muted">Start by creating your first post</p>
                        <a href="/posts/compose" class="btn btn-pink btn-sm">Create Post</a>
                    <% } %>
                </div>
            <% } %>
        </div>
    </div>
</div>

<%- include('partials/footer') %>